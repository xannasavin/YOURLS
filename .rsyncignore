# rsync filter rules for .github/workflows/deploy.yml (--filter="merge ...").
#
# Rules are checked top to bottom, first match wins. Prefixes:
#   -  exclude on both sides: not uploaded AND protected from --delete.
#      Used for server-only files (user/config.php, .htaccess, ...).
#   H  hide on the sender only: not uploaded, but NOT protected, so a copy
#      on the server is deleted. Used for repo-only files that must not be
#      served (the old FTP deploy uploaded them by mistake).
#   R  receiver-side "risk": lifts the protection of a later "-" rule, so
#      the server copy gets deleted.
#   +  include.

# --- Repo-only files: never served, removed from the server if present ---
H .git/
H .github/
H .gitignore
H .gitattributes
H .git-blame-ignore-revs
H .git-ftp-ignore
H .rsyncignore
H .editorconfig
H .claude/
H .claude-bw/
H *.md
H /LICENSE
H /readme.html
H /composer.json
H /composer.lock
H /phpunit.xml
H /phpunit.xml.dist
H /sample-*.txt
H /tests/
H /build/
H /coverage/
H /includes/**/tests/
H /includes/vendor/build-script/
H /includes/vendor/composer/installed.json
H /includes/vendor/**/composer.json
H /includes/geo/*.txt
H .ftp-deploy-sync-state.json

# Demo code under user/ that the old FTP deploy uploaded
H /user/config-sample.php
R /user/config-sample.php
H /user/pages/examplepage.php
R /user/pages/examplepage.php
H /user/plugins/sample-*/***
R /user/plugins/sample-*/***
# Local test script of the own plugin
H /user/plugins/fuehringer/tests/

# --- user/: only the plugins we use + index.html guards ---
# Everything else in user/ (config.php, languages, pages, extra plugins)
# lives on the server only and must never be overwritten or deleted.
# Plugins: the own site plugin + the upstream core plugin hyphens-in-urls.
+ /user/
+ /user/index.html
+ /user/languages/
+ /user/languages/index.html
+ /user/pages/
+ /user/pages/index.html
+ /user/plugins/
+ /user/plugins/index.html
+ /user/plugins/hyphens-in-urls/***
+ /user/plugins/fuehringer/***
- /user/**

# --- Server-only files in the web root: protected ---
- /.htaccess
- /.user.ini
- /php.ini
- /robots.txt
- /favicon.ico
- /error_log
- /.well-known/
- /cgi-bin/
- *.config
- *.conf

# --- Local junk: neither uploaded nor touched ---
- .vscode/
- .vs/
- .idea/
- /nbproject/
- .DS_Store
- Thumbs.db
- Desktop.ini
- *.swp
- *~
